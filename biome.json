{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error",
				"noArrayIndexKey": "off"
			},
			"complexity": {
				"noForEach": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "info",
				"noUnusedImports": "error"
			},
			"style": {
				"noUnusedTemplateLiteral": {
					"level": "error",
					"fix": "safe"
				},
				"noNonNullAssertion": "warn",
				"noProcessEnv": "error"
			},
			"a11y": {
				"noStaticElementInteractions": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/tsconfig.*.json", "**/tsconfig.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				},
				"formatter": {
					"trailingCommas": "all"
				}
			}
		},
		{
			"includes": ["turbo.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": false
				},
				"formatter": {
					"trailingCommas": "none"
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"css": {
				"parser": {
					"tailwindDirectives": true
				}
			}
		},
		{
			"includes": ["apps/mobile/**/*.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noUnknownAtRules": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.spec.ts",
				"**/*.test.ts",
				"**/*.spec.tsx",
				"**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"performance": {
						"noDelete": "off"
					}
				}
			}
		},
		{
			"includes": [
				"apps/*/src/config.ts",
				"apps/dashboard/src/lib/config.ts",
				"apps/mobile/app.config.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!!**/.next",
			"!!**/.turbo",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/build",
			"!!**/target",
			"!!**/.anchor",
			"!**/.expo",
			"!**/apps/mobile/ios",
			"!**/apps/mobile/android",
			"!**/apps/mobile/web-build"
		]
	},
	"javascript": {
		"jsxRuntime": "reactClassic"
	}
}
