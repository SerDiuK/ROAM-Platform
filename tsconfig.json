{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"target": "ES2022",
		"module": "ES2022",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"composite": true,
		"outDir": "dist",
		"rootDir": "src",
	},
	"exclude": ["node_modules", "dist"],
}
