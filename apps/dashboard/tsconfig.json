{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"jsx": "preserve",
		"noEmit": true,
		"rootDir": ".",
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"incremental": true,
		"isolatedModules": true,
		"plugins": [
			{
				"name": "next",
			},
		],
		"paths": {
			"@/*": ["./src/*"],
		},
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"resolveJsonModule": true,
	},
	"include": ["src", "next-env.d.ts", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".next"],
}
