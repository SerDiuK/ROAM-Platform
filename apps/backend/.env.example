MONGODB_URL=mongodb://localhost:27018/roam?directConnection=true

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# openssl rand -hex 32. Changing it later orphans the events already on chain.
CHAIN_HMAC_KEY=
# At least 32 characters, e.g. openssl rand -hex 32
AUTH_SECRET=

# Base58 secret key of the devnet fee payer. Without it nothing is written on chain and responders can't accept.
SOLANA_OPERATOR_KEYPAIR=
# Solana address that receives the x402 settlement
X402_RECIPIENT_ADDRESS=

# Optional, defaults shown
# PORT=3001
# MQTT_PORT=1883
# SOLANA_CLUSTER=devnet
# X402_NETWORK=solana-devnet
# DASHBOARD_ORIGINS=http://localhost:3000
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AGENT_MAX_TURNS=8
# AUTH_TOKEN_TTL_SECS=60
# EXPO_ACCESS_TOKEN=
