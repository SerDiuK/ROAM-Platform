PORT=3001
MONGODB_URL=mongodb://localhost:27017/roam?directConnection=true
#MONGODB_URL=mongodb+srv://USER:PASS@roam.ch5lgev.mongodb.net/roam?retryWrites=true&w=majority
MQTT_PORT=1883
COT_PORT=8087
SOLANA_CLUSTER=devnet
SOLANA_OPERATOR_KEYPAIR=
DASHBOARD_ORIGINS=http://localhost:3000
WALLET_PROVIDER=embedded-solana

# Wallet
# 32-byte hex (64 chars). Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Operator session JWT
# 32+ char secret. Generate with: openssl rand -hex 32
# Rotating this invalidates every issued token — operators just sign in again.
AUTH_SECRET=
# JWT lifetime in seconds. Defaults to 30 days if unset.
#AUTH_TOKEN_TTL_SECS=2592000

# Push notifications
# Optional — only needed for standalone production app; Expo Go delivers without it
EXPO_ACCESS_TOKEN=

# STT (Deepgram)
DEEPGRAM_API_KEY=

CHAIN_HMAC_KEY=replace-me-with-openssl-rand-hex-32
