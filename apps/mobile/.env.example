# Required at build time. Baked into AndroidManifest.xml by Expo prebuild.
# Get from Google Cloud Console → APIs & Services → Credentials.
# Restrict the key to package dev.tgmgoethals.roam.mobile + your SHA-1 fingerprint.
GOOGLE_MAPS_API_KEY=

# Optional runtime overrides — defaults derive from Expo hostUri (Metro LAN).
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com
# EXPO_PUBLIC_WS_URL=wss://api.example.com
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
