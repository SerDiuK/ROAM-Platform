{
	"expo": {
		"name": "ROAM Mobile",
		"slug": "roam-mobile",
		"owner": "tgmgoethals",
		"version": "0.0.1",
		"orientation": "portrait",
		"scheme": "roam-mobile",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"plugins": [
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "ROAM uses your location to center the map on your position."
				}
			],
			"expo-font",
			"expo-notifications",
			"expo-secure-store"
		],
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "com.cardnexus.roam.mobile",
			"icon": "./assets/icon.png"
		},
		"android": {
			"package": "com.cardnexus.roam.mobile",
			"googleServicesFile": "./google-services.json",
			"config": {
				"googleMaps": { "apiKey": "AIzaSyDpM1dKmJnJyr_cWPfrwC4amMADgP7fMDA" }
			},
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"monochromeImage": "./assets/adaptive-icon-monochrome.png",
				"backgroundColor": "#000000"
			},
			"permissions": [
				"android.permission.ACCESS_COARSE_LOCATION",
				"android.permission.ACCESS_FINE_LOCATION"
			]
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/favicon.ico"
		},
		"extra": {
			"eas": {
				"projectId": "7021fefb-983f-422f-866f-2d7b4d262e77"
			}
		}
	}
}
