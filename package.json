{
	"name": "roam-platform",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"lint": "turbo lint",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:ci": "biome ci .",
		"roam": "pnpm --filter @roam/cli dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.0",
		"eas-cli": "^18.10.0",
		"mocha": "^11.7.5",
		"ts-mocha": "^11.1.0",
		"turbo": "^2.5.0",
		"typescript": "^5.7.0"
	},
	"packageManager": "pnpm@10.5.2",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@serialport/bindings-cpp"
		],
		"overrides": {
			"react": "19.2.6",
			"react-dom": "19.2.6",
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3"
		}
	}
}
